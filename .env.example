# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.

# Admin login (8+ characters).
ADMIN_PASSWORD=
# 32+ random characters, e.g. from: openssl rand -hex 32
ADMIN_SECRET=

# Same values as the current adityachitoshiya.in project.
# Leave MONGODB_URI empty locally to save to .data/content.json instead.
MONGODB_URI=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
